.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw article source images — local staging only, do not deploy
/resources/articles/

# Walkthrough authoring sources — large lossless captures, gitignored.
# Markdown guides (guide.md) in the same directories are tracked normally.
/resources/walkthroughs/**/*.png
/resources/walkthroughs/**/*.jpg
/resources/walkthroughs/**/*.jpeg
/resources/walkthroughs/**/*.webp

# LinkedIn integration — local OAuth state during three-legged flow
/scripts/.linkedin-cache/

# Claude Code runtime state
.claude/scheduled_tasks.lock

# Windows shell shortcuts
*.lnk
